# Optional, server-only metrics authentication. Set in Netlify Functions environment.
LOOPHOLE_ADMIN_TOKEN=
# Existing server-only connection for cited retailer search.
ANTHROPIC_API_KEY=
# Optional Amazon offer data connection; never expose in frontend.
RAINFOREST_API_KEY=
# Default: claude-haiku-4-5-20251001
LOOPHOLE_SEARCH_MODEL=claude-haiku-4-5-20251001
# Official eBay Buy/Browse connection. Server-only; both credentials required.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production or sandbox. Sandbox never enables purchasing.
EBAY_ENVIRONMENT=production
# Clamped to 15–60 minutes. Default 30.
CIRCULAR_LISTING_CACHE_MINUTES=30
# Optional only for a Vercel deployment using the existing private Netlify store.
# Do not configure these in the frontend or commit their values.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
