{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "assets/experiments.mjs",
    "assets/same-thing-demos.mjs",
    "experiments/same-thing/**/*.mjs",
    "experiments/same-thing/**/*.d.ts",
    "lib/studio-api.mjs",
    "netlify/functions/email-capture.mjs",
    "netlify/functions/same-thing.mjs",
    "netlify/functions/studio-event.mjs"
  ]
}
