{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/*.mjs": {"includeFiles": ".generated/circular/**", "maxDuration": 60}},
  "redirects": [
    {"source":"/purchase-checker/:path*","destination":"/","permanent":false},
    {"source":"/samething","destination":"/samething/","permanent":true}
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://*.ebayimg.com data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"}
  ]}]
}
