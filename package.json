{
  "name": "thisloophole_site",
  "private": true,
  "scripts": {
    "compile:tools": "tsc -p tsconfig.circular.json && tsc -p tsconfig.auto.json",
    "dev": "npm run compile:tools && node scripts/dev.mjs",
    "build": "npm run compile:tools && node scripts/build.mjs",
    "test": "npm run compile:tools && node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.circular.json --noEmit && tsc -p tsconfig.auto.json --noEmit",
    "check:data": "node scripts/validate-data.mjs",
    "check:dealership": "node scripts/dealership/audit-catalog.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "dealership-blobs": "npm:@netlify/blobs@^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
