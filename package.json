{
  "name": "thisloophole_site",
  "private": true,
  "scripts": {
    "compile:tools": "tsc -p tsconfig.circular.json",
    "vercel-build": "npm run compile:tools",
    "dev": "npm run compile:tools && node scripts/dev.mjs",
    "build": "npm run compile:tools && node scripts/build.mjs",
    "test": "npm run compile:tools && node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.circular.json --noEmit",
    "check:data": "node scripts/validate-data.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
