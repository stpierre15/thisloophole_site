import type { ComparisonResult, RankedListing } from './schema.mjs';
export const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
export const money=(n:number|null)=>n===null?'Not confirmed':new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(n);
const checked=(v:string)=>new Date(v).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'UTC'})+' UTC';
function card(c:RankedListing,r:ComparisonResult) {
 const top=c.id===r.bestValueOption?.id;
 const link=r.mode==='live'&&!c.demo?`<a class="text-link" href="/api/circular-outbound?result=${encodeURIComponent(r.id)}&amp;listing=${encodeURIComponent(c.id)}" target="_blank" rel="noopener noreferrer">${c.previousModel?'Check the previous model':c.condition==='refurbished'?'Check refurbished':c.condition==='open_box'?'Check open box':'Check used'} ↗</a>`:'<p class="fine-print">Illustration only. No purchase link or verified inventory.</p>';
 const saving=c.savings===null?'Saving not confirmed':c.savings>0?money(c.savings)+' less · '+c.percentSavings+'% before tax':c.savings===0?'Same price before tax':money(Math.abs(c.savings))+' more before tax';
 return `<article class="circular-listing"><div>${c.imageUrl&&r.mode==='live'?`<img class="listing-image" src="${esc(c.imageUrl)}" alt="" loading="lazy" width="112" height="112">`:''}<p class="eyebrow">${top?'BEST SUPPORTED SAME-PRODUCT TOTAL':c.previousModel?'THE PREVIOUS MODEL':'ANOTHER OPTION'}</p><h3>${esc(c.title)}</h3><p class="match-tag">${esc(c.matchLevel)} · ${c.confidence} CONFIDENCE</p><p class="listing-meta">${esc(c.conditionText)} · ${esc(c.provider)}${c.sellerName?' · '+esc(c.sellerName):''}</p><p class="listing-total">${money(c.totalPrice??c.price)} <small>${c.totalPrice===null?'item price; shipping unknown':'including reported shipping'}</small></p><p class="listing-meta">Item ${money(c.price)} / Shipping ${money(c.shippingPrice)}<br>${esc(saving)}</p>${link}<p class="fine-print">Last checked ${checked(c.fetchedAt)}. Price and availability can change; we recheck before sending you to a live listing.</p></div><details class="catch"><summary>WHAT’S THE CATCH?</summary><ul>${c.tradeoffs.map(t=>'<li>'+esc(t)+'</li>').join('')}</ul><p class="fine-print">Model ${esc(c.model||'not supplied')}${c.mpn?' · MPN '+esc(c.mpn):''}${c.gtin?' · GTIN '+esc(c.gtin):''}. ${Object.entries(c.attributes).map(([k,v])=>esc(k)+': '+esc(v)).join(' · ')}</p><p class="fine-print">${c.matchReasons.map(esc).join(' ')}${c.previousModel&&r.previousModel?` <a href="${esc(r.previousModel.sourceUrl)}" target="_blank" rel="noopener noreferrer">Compare manufacturer specifications ↗</a>`:''}</p></details></article>`;
}
export function renderResult(r:ComparisonResult) {
 const best=r.bestValueOption,saving=r.estimatedSavings;
 const banner=r.mode==='demo'?'DEMO / FICTIONAL PRICES. NOT LIVE INVENTORY.':r.mode==='sandbox'?'SANDBOX / TEST INVENTORY. NOT AVAILABLE TO BUY.':r.mode==='unconfigured'?'LIVE SEARCH NOT CONNECTED.':'SOURCE / EBAY BROWSE API';
 const priceLabel=r.sourceProduct.priceBasis==='demo'?'Illustrative new price':r.sourceProduct.priceBasis==='user'?'Your new-price baseline':r.sourceProduct.priceBasis==='retailer'?'Listed new-price baseline':'New price — add yours above';
 return `<div class="result-heading"><p class="mode-label">${banner}</p><h2 tabindex="-1" id="result-title">${esc(r.verdict)}</h2><p>${esc(r.sourceProduct.productName)}${r.sourceProduct.model?' · '+esc(r.sourceProduct.model):''}</p>${r.sourceProduct.sourceUrl?`<p class="fine-print"><a class="text-link" href="${esc(r.sourceProduct.sourceUrl)}" target="_blank" rel="noopener noreferrer">Original listing ↗</a> · ${r.sourceProduct.identityBasis==='url'?'Product name suggested from URL':r.sourceProduct.identityBasis==='user'?'Product details confirmed by you':'Product metadata observed '+checked(r.sourceProduct.updatedAt)}. Confirm the baseline above.</p>`:''}<p class="fine-print">${r.sourceProduct.mpn?'MPN '+esc(r.sourceProduct.mpn)+' · ':''}${r.sourceProduct.gtin?'GTIN '+esc(r.sourceProduct.gtin)+' · ':''}Last checked ${checked(r.fetchedAt)}${r.cacheHit?' · cached observation':''}. Listings refresh after the displayed freshness window: ${Math.max(0,Math.round((r.expiresAt-new Date(r.fetchedAt).getTime())/60000))} minutes.</p></div><div class="circular-totals"><div><span>${priceLabel}</span><strong>${money(r.sourceProduct.newPrice)}</strong></div><div><span>Best supported same-product total</span><strong>${money(best?.totalPrice??null)}</strong></div><div><span>${saving!==null&&saving<0?'EXTRA COST':'YOU KEEP / BEFORE TAX'}</span><strong>${money(saving===null?null:Math.abs(saving))}</strong></div><div><span>Percent less</span><strong>${r.percentSavings!==null&&r.percentSavings>0?r.percentSavings+'%':'—'}</strong></div></div><div class="loophole-take"><p class="eyebrow">THE LOOPHOLE TAKE</p><p>${esc(r.take)}</p></div>${r.previousModel?`<p class="fine-print">Previous-model support: ${esc(r.previousModel.currentModel)} → ${esc(r.previousModel.previousModel)}. This is an alternative generation, never an exact-product claim.</p>`:''}<div class="circular-listings">${r.candidates.map(c=>card(c,r)).join('')}</div><div class="result-warnings">${r.warnings.map(w=>'<p class="fine-print">'+esc(w)+'</p>').join('')}</div><div class="result-share"><button type="button" data-result-share="link">Copy link</button><button type="button" data-result-share="share">Share</button><button type="button" data-result-share="text">Copy result</button><span id="result-share-status" class="fine-print" role="status"></span></div>${r.mode==='unconfigured'?'<p><button type="button" class="plain-button" data-demo="camera">Try the camera example ↗</button> · <button type="button" class="plain-button" data-demo="phone">Try the small-savings example ↗</button></p>':''}`;
}
export function shareText(r:ComparisonResult,url:string) {
 const demo=r.mode==='demo'||r.mode==='sandbox'?'DEMO — fictional/test prices; not inventory.\n':'';
 return demo+'THE SAME THING\n'+r.sourceProduct.productName+'\nNEW '+money(r.sourceProduct.newPrice)+'\nSECOND-LIFE TOTAL '+money(r.bestValueOption?.totalPrice??null)+'\n'+(r.estimatedSavings!==null&&r.estimatedSavings<0?'EXTRA COST ':'YOU KEEP ')+money(r.estimatedSavings===null?null:Math.abs(r.estimatedSavings))+'\n'+r.verdict+'\nBefore tax. Last checked '+checked(r.fetchedAt)+'.\n'+url;
}
