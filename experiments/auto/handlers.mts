import type { Store,VehicleInventoryProvider,VinDecoder } from './schema.mjs';
import { AutoInputError,decodeVin,demoDealPlan,loadDealPlan,savePaidDealPlan,searchVehicles,vehicleDetail } from './service.mjs';
const json=(data:unknown,status=200)=>new Response(JSON.stringify(data),{status,headers:{'content-type':'application/json','cache-control':'no-store','x-content-type-options':'nosniff'}});
async function body(request:Request){if(request.method!=='POST')throw new AutoInputError('Use POST for this request.',405);const origin=request.headers.get('origin');if(origin&&origin!==new URL(request.url).origin)throw new AutoInputError('Cross-origin requests are not accepted.',403);if(!request.headers.get('content-type')?.startsWith('application/json'))throw new AutoInputError('Send JSON.',415);const raw=await request.text();if(raw.length>12000)throw new AutoInputError('Request is too large.',413);try{const value=JSON.parse(raw);if(!value||typeof value!=='object'||Array.isArray(value))throw Error();return value;}catch{throw new AutoInputError('Invalid request.',400)}}
const safe=(fn:(request:Request,context:any)=>Promise<Response>)=>async(request:Request,context:any={})=>{try{return await fn(request,context)}catch(e){const error=e as any;if(!error?.status)console.error('Auto request failed:',error?.name||'Error');return json({error:error?.status?error.message:'Vehicle intelligence is temporarily unavailable.'},error?.status||503)}};
const emailOf=(v:any)=>{const email=typeof v==='string'?v.trim().toLowerCase():'';if(email&&!/^[^\s@]{1,64}@[^\s@]{1,190}\.[^\s@]{2,24}$/.test(email))throw new AutoInputError('Enter a valid email address.');return email||null};
async function stripeRequest(path:string,init:RequestInit={}){const key=process.env.STRIPE_SECRET_KEY;if(!key)throw new AutoInputError('Deal Plan checkout is not connected yet.',503);const response=await fetch('https://api.stripe.com/v1/'+path,{...init,redirect:'error',signal:AbortSignal.timeout(12000),headers:{Authorization:'Bearer '+key,...(init.headers||{})}});const data=await response.json();if(!response.ok)throw new AutoInputError('Stripe could not start or verify checkout. Please retry.',502);return data;}
export function createAutoHandlers(store:(context:any)=>Store,provider:VehicleInventoryProvider,decoder:VinDecoder){
 return {
  search:safe(async(request,context)=>json(await searchVehicles(await body(request),store(context),provider,decoder))),
  detail:safe(async(request,context)=>{if(request.method!=='GET')throw new AutoInputError('Use GET for this request.',405);return json(await vehicleDetail(new URL(request.url).searchParams.get('id')||'',store(context),provider));}),
  vin:safe(async(request,context)=>json({vehicle:await decodeVin((await body(request)).vin,store(context),decoder)})),
  checkout:safe(async(request,context)=>{const input=await body(request),listingId=String(input.listingId||''),email=emailOf(input.email),price=process.env.STRIPE_DEAL_PLAN_PRICE_ID;if(!/^[a-f0-9]{32}$/.test(listingId))throw new AutoInputError('Choose a vehicle first.');await vehicleDetail(listingId,store(context),provider);if(!price)throw new AutoInputError('Deal Plan checkout is not connected yet.',503);const origin=new URL(request.url).origin,form=new URLSearchParams({'mode':'payment','line_items[0][price]':price,'line_items[0][quantity]':'1','metadata[listingId]':listingId,'success_url':origin+'/deal-plan/'+listingId+'/?session_id={CHECKOUT_SESSION_ID}','cancel_url':origin+'/deal-plan/'+listingId+'/?cancelled=1'});if(email)form.set('customer_email',email);const session=await stripeRequest('checkout/sessions',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:form});return json({url:session.url},201);}),
  deal:safe(async(request,context)=>{if(request.method!=='GET')throw new AutoInputError('Use GET for this request.',405);const url=new URL(request.url),db=store(context),token=url.searchParams.get('token');if(token)return json(await loadDealPlan(token,db));const id=url.searchParams.get('id')||'';if(url.searchParams.get('demo')==='1')return json(await demoDealPlan(id,db,provider));const sessionId=url.searchParams.get('session_id');if(!/^cs_(?:test|live)_[A-Za-z0-9]+$/.test(sessionId||''))throw new AutoInputError('Complete checkout to view this Deal Plan.',402);const saved=await db.get('auto/stripe-sessions/'+sessionId);if(saved?.token)return json(await loadDealPlan(saved.token,db));const session=await stripeRequest('checkout/sessions/'+encodeURIComponent(sessionId!));if(session.payment_status!=='paid'||session.metadata?.listingId!==id||session.currency!=='usd'||session.amount_total!==4900)throw new AutoInputError('Payment has not been verified for the $49 Deal Plan.',402);const report=await savePaidDealPlan(id,emailOf(session.customer_details?.email||session.customer_email),session.payment_intent||session.id,db,provider);await db.set('auto/stripe-sessions/'+sessionId,{token:report.token,listingId:id,createdAt:new Date().toISOString()});return json(report,201);})
 };
}
