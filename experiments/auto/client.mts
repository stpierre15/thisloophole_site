import type { DealReport,VehicleResult,VehicleSearchResponse } from './schema.mjs';
const page=document.body.dataset.page||'',money=(n:number|null)=>n===null?'Not enough data':new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n),number=(n:number|null)=>n===null?'Not supplied':n.toLocaleString('en-US'),esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const event=(name:string,metadata:Record<string,string>={})=>fetch('/api/studio-event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,metadata})}).catch(()=>{});
async function api(path:string,body?:unknown){const response=await fetch(path,{signal:AbortSignal.timeout(30000),...(body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})});let data:any;try{data=await response.json()}catch{throw Error('The service did not respond. Please retry.')}if(!response.ok)throw Error(data.error||'Please retry.');return data;}
const idFromPath=(segment:string)=>{const parts=location.pathname.split('/').filter(Boolean),i=parts.indexOf(segment);return i>=0?parts[i+1]||'':new URL(location.href).searchParams.get('id')||''};
function reasons(r:VehicleResult){return r.analysis.reasons.map(x=>'<li>'+esc(x)+'</li>').join('')}
function resultCard(r:VehicleResult){const name=[r.vehicle.year,r.vehicle.make,r.vehicle.model,r.vehicle.trim].filter(Boolean).join(' '),href='/car/'+r.listing.id+'/';return `<article class="vehicle-row"><a class="score-block" href="${href}" aria-label="View ${esc(name)}"><span>LOOPHOLE<br>SCORE</span><strong>${r.analysis.score}</strong></a><div class="vehicle-main"><p class="meta">${r.listing.demo?'DEMO VEHICLE · NOT FOR SALE':esc(r.dealer.city+', '+r.dealer.state)}</p><h2><a href="${href}">${esc(name)}</a></h2><p class="price">${money(r.listing.currentPrice)} <span>${number(r.listing.mileage)} miles</span></p><p class="eyebrow">WHY LOOPHOLE IS WATCHING IT</p><ul class="reason-list">${reasons(r)}</ul><a class="text-link" href="${href}">VIEW INTELLIGENCE →</a></div></article>`}
function scoreParts(r:VehicleResult){const parts=[['PRICE POSITION',r.analysis.components.pricePosition],['TIME OBSERVED',r.analysis.components.timeObserved],['PRICE CUTS',r.analysis.components.priceCuts],['LOCAL COMPETITION',r.analysis.components.localCompetition],['DEPRECIATION CONTEXT',r.analysis.components.depreciationContext]];return parts.map(([label,value])=>`<div><span>${label}</span><strong>${value}</strong></div>`).join('')}
function detailHtml(r:VehicleResult){const name=[r.vehicle.year,r.vehicle.make,r.vehicle.model,r.vehicle.trim].filter(Boolean).join(' '),history=r.observations.map(x=>`<li><time>${new Date(x.observedAt).toLocaleDateString('en-US',{month:'short',day:'2-digit'})}</time><strong>${money(x.price)}</strong></li>`).join(''),take=r.analysis.reasons.length>1?'This one is worth investigating. '+r.analysis.reasons.join(', ').replace(/^./,c=>c.toUpperCase())+'.':'The observable evidence is still limited. Treat the score as a prompt to investigate, not a conclusion.';return `<section class="detail-hero"><div><p class="meta">${r.listing.demo?'DEMO VEHICLE · NOT FOR SALE':esc(r.dealer.name+' · '+r.dealer.city+', '+r.dealer.state)}</p><h1>${esc(name)}</h1><p class="price">${money(r.listing.currentPrice)} <span>${number(r.listing.mileage)} miles</span></p><p class="identity">VIN ${esc(r.vehicle.vin||'NOT SUPPLIED')} · ${esc(r.vehicle.drivetrain||'DRIVE TYPE NOT SUPPLIED')}</p></div><div class="hero-score"><span>LOOPHOLE SCORE</span><strong>${r.analysis.score}</strong><small>${r.analysis.confidence} CONFIDENCE</small></div></section><p class="disclosure">${esc(r.analysis.disclosure)}</p><section class="detail-grid"><div><p class="eyebrow">PRICE HISTORY</p><ol class="price-history">${history}</ol></div><div class="big-stat"><span>OBSERVED</span><strong>${r.daysObserved}</strong><small>DAYS</small></div></section><section class="compare-section"><p class="eyebrow">LOCAL COMPARABLES</p><div class="compare-numbers"><div><span>MEDIAN</span><strong>${money(r.comparable.medianPrice)}</strong></div><div><span>THIS LISTING</span><strong>${money(r.listing.currentPrice)}</strong></div><div><span>DIFFERENCE</span><strong>${money(r.comparable.priceDeltaFromMedian)}</strong></div></div><p class="disclosure">${r.comparable.comparableCount} deterministic comparable${r.comparable.comparableCount===1?'':'s'}: same make and model, adjacent model year, and a similar mileage band within the returned inventory.</p></section><section class="score-explainer"><p class="eyebrow">SCORE COMPONENTS</p><div>${scoreParts(r)}</div></section><section class="loophole-take"><p class="eyebrow">LOOPHOLE TAKE</p><p>${esc(take)}</p></section><section class="deal-cta"><div><p class="eyebrow">BUYING THIS ONE?</p><h2>GET THE DEAL PLAN.</h2><p>Comparable vehicles, negotiation range, message script, dealership process, and an F&amp;I checklist.</p></div><div><strong>$49</strong><a class="button" href="/deal-plan/${r.listing.id}/">GET THE DEAL PLAN →</a></div></section>${r.listing.demo?'<p class="demo-strip">DEMO DATA. This listing is fictional and has no dealer link.</p>':r.listing.url?'<p><a class="button secondary" id="dealer-link" href="'+esc(r.listing.url)+'" target="_blank" rel="noopener noreferrer">VIEW DEALER LISTING →</a></p>':''}`}
async function cars(){event('vehicle_search',{stage:'page_view'});const form=document.querySelector<HTMLFormElement>('#vehicle-search')!,output=document.querySelector<HTMLElement>('#search-results')!,status=document.querySelector<HTMLElement>('#search-status')!;form.addEventListener('submit',async e=>{e.preventDefault();if(!form.reportValidity())return;const data=Object.fromEntries(new FormData(form)),button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;status.textContent='Checking observable inventory…';try{event('vehicle_search',{make:String(data.make).slice(0,40),model:String(data.model).slice(0,40)});const result=await api('/api/vehicle-search',{...data,radius:Number(data.radius),yearMin:data.yearMin?Number(data.yearMin):undefined,yearMax:data.yearMax?Number(data.yearMax):undefined,maxPrice:data.maxPrice?Number(data.maxPrice):undefined}) as VehicleSearchResponse;event('search_results_view',{mode:result.mode,count:String(result.results.length)});output.innerHTML=`<div class="results-head"><div><p class="eyebrow">RANKED FOR THE BUYER</p><h1>${result.results.length} RESULT${result.results.length===1?'':'S'}</h1></div><p>${esc(result.disclosure)}</p></div>`+(result.results.length?result.results.map(resultCard).join(''):'<div class="empty-state"><h2>No supported vehicles returned.</h2><p>This is a data-source result, not proof that no inventory exists. Try a broader model name or radius.</p></div>');output.hidden=false;status.textContent='Results ready.';output.scrollIntoView({block:'start'});}catch(error){status.textContent=error instanceof Error?error.message:'Please retry.';}finally{button.disabled=false;}});document.querySelector<HTMLButtonElement>('[data-demo-search]')?.addEventListener('click',()=>{(form.elements.namedItem('zip') as HTMLInputElement).value='78701';(form.elements.namedItem('make') as HTMLInputElement).value='Toyota';(form.elements.namedItem('model') as HTMLInputElement).value='Land Cruiser';form.requestSubmit();});}
async function detail(){event('vehicle_detail_view');const root=document.querySelector<HTMLElement>('#vehicle-detail')!;try{const result=await api('/api/vehicle-detail?id='+encodeURIComponent(idFromPath('car'))) as VehicleResult;root.innerHTML=detailHtml(result);document.querySelector('#dealer-link')?.addEventListener('click',()=>event('dealer_link_clicked'));}catch(error){root.innerHTML='<div class="empty-state"><h1>Vehicle unavailable.</h1><p>'+esc(error instanceof Error?error.message:'Please search again.')+'</p><a class="button" href="/cars/">SEARCH VEHICLES →</a></div>';}}
function reportHtml(report:DealReport){const p=report.reportData,r=p.vehicle,name=[r.vehicle.year,r.vehicle.make,r.vehicle.model,r.vehicle.trim].filter(Boolean).join(' ');return `<div class="report-label">${report.status==='demo'?'DEMO DEAL PLAN · NOT PURCHASED':'PAID DEAL PLAN'}</div><section class="report-title"><p class="eyebrow">LOOPHOLE DEAL PLAN</p><h1>${esc(name)}</h1><p>${money(p.askingPrice)} · ${number(r.listing.mileage)} miles · VIN ${esc(r.vehicle.vin||'not supplied')}</p></section><section><p class="eyebrow">MARKET POSITION</p><div class="compare-numbers"><div><span>LOCAL MEDIAN</span><strong>${money(r.comparable.medianPrice)}</strong></div><div><span>PRICE PERCENTILE</span><strong>${r.comparable.percentile===null?'—':r.comparable.percentile+'TH'}</strong></div><div><span>DAYS OBSERVED</span><strong>${r.daysObserved}</strong></div></div></section><section><p class="eyebrow">ESTIMATED NEGOTIATION STRATEGY</p><div class="negotiation"><div><span>ASKING</span><strong>${money(p.askingPrice)}</strong></div><div><span>OPENING TARGET</span><strong>${money(p.openingTarget)}</strong></div><div><span>REASONABLE TARGET RANGE</span><strong>${money(p.targetLow)}–${money(p.targetHigh)}</strong></div><div><span>WALK-AWAY CONSIDERATION</span><strong>${money(p.walkAwayConsideration)}+</strong></div></div><p class="disclosure">${esc(p.estimateDisclosure)}</p></section><section><p class="eyebrow">WHY</p><ul class="plain-list">${p.reasons.map(x=>'<li>'+esc(x)+'</li>').join('')}</ul></section><section><p class="eyebrow">DEALERSHIP PROCESS</p><ol class="process-list">${p.process.map(x=>'<li>'+esc(x)+'</li>').join('')}</ol></section><section><p class="eyebrow">MESSAGE SCRIPT</p><div class="script-box"><p>${esc(p.message)}</p><button class="text-button" id="copy-script">COPY SCRIPT</button></div></section><section><p class="eyebrow">F&amp;I CHECKLIST</p><div class="checklist">${p.checklist.map(x=>`<details><summary>${esc(x.name)}</summary><p><strong>Ask:</strong> ${esc(x.questions)}</p><p><strong>May be useful:</strong> ${esc(x.whenUseful)}</p></details>`).join('')}</div></section><p class="disclosure">Deal Plan estimates exclude tax, title, registration, trade-in, financing and unverified fees. Ask for an itemized out-the-door quote.</p>`}
async function deal(){event('deal_plan_started');const id=idFromPath('deal-plan'),root=document.querySelector<HTMLElement>('#deal-plan')!,params=new URL(location.href).searchParams,session=params.get('session_id'),token=params.get('token');if(session||token){try{root.innerHTML='<p class="loading">Verifying the Deal Plan…</p>';const report=await api('/api/deal-plan?'+new URLSearchParams(session?{id,session_id:session}:{token:token!}));if(report.status==='paid'&&session)event('deal_plan_purchased');event('deal_plan_viewed',{status:report.status});root.innerHTML=reportHtml(report);document.querySelector('#copy-script')?.addEventListener('click',async e=>{await navigator.clipboard.writeText(report.reportData.message);(e.currentTarget as HTMLElement).textContent='COPIED';});}catch(error){root.innerHTML='<div class="empty-state"><h1>Deal Plan unavailable.</h1><p>'+esc(error instanceof Error?error.message:'Please retry.')+'</p></div>';}return;}root.innerHTML=`<section class="plan-pitch"><p class="eyebrow">LOOPHOLE DEAL PLAN</p><h1>BUY THE CAR.<br>KEEP YOUR LEVERAGE.</h1><p class="plan-price">$49 <span>ONE TIME</span></p><ul><li>Comparable vehicles and market position</li><li>Estimated negotiation range</li><li>Dealer email and text script</li><li>Out-the-door process</li><li>Fee and add-on checklist</li><li>Walk-away conditions</li></ul><label for="plan-email">EMAIL FOR YOUR RECEIPT</label><input id="plan-email" type="email" autocomplete="email" placeholder="you@example.com"><button class="button" id="checkout">GET THE DEAL PLAN →</button><button class="text-button" id="preview-plan">PREVIEW WITH DEMO DATA</button><p class="form-status" id="plan-status" role="status"></p><p class="disclosure">No subscription. Estimated strategy, not a promise of dealer acceptance.</p></section>`;document.querySelector('#checkout')?.addEventListener('click',async()=>{const status=document.querySelector<HTMLElement>('#plan-status')!;status.textContent='Starting secure checkout…';event('deal_plan_checkout_started');try{const out=await api('/api/deal-plan-checkout',{listingId:id,email:(document.querySelector<HTMLInputElement>('#plan-email')!).value});location.href=out.url;}catch(error){status.textContent=error instanceof Error?error.message:'Checkout unavailable.';}});document.querySelector('#preview-plan')?.addEventListener('click',async()=>{const status=document.querySelector<HTMLElement>('#plan-status')!;status.textContent='Building a clearly labeled preview…';try{const report=await api('/api/deal-plan?id='+encodeURIComponent(id)+'&demo=1');root.innerHTML=reportHtml(report);}catch(error){status.textContent=error instanceof Error?error.message:'Preview unavailable.';}});}
if(page==='home')event('homepage_view');if(page==='cars')cars();if(page==='car')detail();if(page==='deal-plan')deal();
