import { createHash,randomUUID } from 'node:crypto';
import { analyze } from './analysis.mjs';
import type { DealPlanData,DealReport,PriceObservation,Store,VehicleInventoryProvider,VehicleListing,VehicleListingInput,VehicleResult,VehicleSearchInput,VinDecoder,VinIdentity } from './schema.mjs';
const hash=(v:string)=>createHash('sha256').update(v).digest('hex').slice(0,32),money=(n:number,step=250)=>Math.round(n/step)*step;
export class AutoInputError extends Error{constructor(message:string,public status=400){super(message)}}
const text=(v:unknown,max=80)=>typeof v==='string'?v.replace(/[<>\x00-\x1f]/g,' ').replace(/\s+/g,' ').trim().slice(0,max):'';
export function cleanSearch(input:any):VehicleSearchInput{const zip=text(input?.zip,5),make=text(input?.make),model=text(input?.model),radius=Number(input?.radius||100);if(!/^\d{5}$/.test(zip))throw new AutoInputError('Enter a five-digit ZIP code.');if(make.length<2||model.length<1)throw new AutoInputError('Enter a make and model.');if(![25,50,100,200,500].includes(radius))throw new AutoInputError('Choose a supported search radius.');const yearMin=input.yearMin?Number(input.yearMin):undefined,yearMax=input.yearMax?Number(input.yearMax):undefined,maxPrice=input.maxPrice?Number(input.maxPrice):undefined;if(yearMin&&(!Number.isInteger(yearMin)||yearMin<1981||yearMin>new Date().getFullYear()+1))throw new AutoInputError('Enter a valid starting year.');if(yearMax&&(!Number.isInteger(yearMax)||yearMax<1981||yearMax>new Date().getFullYear()+1))throw new AutoInputError('Enter a valid ending year.');if(yearMin&&yearMax&&yearMin>yearMax)throw new AutoInputError('Starting year must be before ending year.');if(maxPrice&&(!Number.isFinite(maxPrice)||maxPrice<1000||maxPrice>1000000))throw new AutoInputError('Enter a valid maximum price.');return {zip,make,model,radius,yearMin,yearMax,maxPrice};}
const listingId=(x:VehicleListingInput)=>hash(x.provider+'|'+x.providerListingId);
export async function observe(input:VehicleListingInput,db:Store):Promise<VehicleListing>{const id=listingId(input),key='auto/listings/'+id,old=await db.get(key),first=old?.firstObservedAt||input.firstObservedAt||input.observedAt;const listing:VehicleListing={...input,id,vehicleId:input.vehicle.id,dealerId:input.dealer.id,firstObservedAt:first,lastObservedAt:input.observedAt,missingChecks:0};delete listing.seededObservations;await db.set('auto/dealers/'+input.dealer.id,input.dealer);await db.set('auto/vehicles/'+input.vehicle.id,input.vehicle);if(!old){for(const x of input.seededObservations||[{observedAt:input.observedAt,price:input.currentPrice,mileage:input.mileage}]){const row:PriceObservation={id:hash(id+'|'+x.observedAt+'|'+x.price),listingId:id,...x};await db.set('auto/observations/'+id+'/'+row.id,row);}}else if(old.currentPrice!==input.currentPrice){const row:PriceObservation={id:hash(id+'|'+input.observedAt+'|'+input.currentPrice),listingId:id,observedAt:input.observedAt,price:input.currentPrice,mileage:input.mileage};await db.set('auto/observations/'+id+'/'+row.id,row);}await db.set(key,listing);return listing;}
export async function markMissing(listing:VehicleListing,db:Store){const missed=(listing.missingChecks||0)+1,next={...listing,missingChecks:missed,active:missed<2};await db.set('auto/listings/'+listing.id,next);return next;}
const observations=async(id:string,db:Store)=>(db.list?await db.list('auto/observations/'+id):[]) as PriceObservation[];
async function analyzeRows(rows:VehicleListing[],db:Store,now:string){return Promise.all(rows.map(async row=>{const result=analyze(row,await observations(row.id,db),rows,now);await db.set('auto/comparables/'+row.id+'/'+result.comparable.id,result.comparable);await db.set('auto/analyses/'+row.id+'/'+result.analysis.id,result.analysis);return result;}));}
export async function searchVehicles(input:any,db:Store,provider:VehicleInventoryProvider,decoder?:VinDecoder){const search=cleanSearch(input),now=new Date().toISOString(),found=await provider.searchVehicles(search);if(decoder)await Promise.all(found.slice(0,12).map(async x=>{if(!x.vehicle.vin)return;try{const decoded=await decodeVin(x.vehicle.vin,db,decoder);if(decoded)x.vehicle={...x.vehicle,year:decoded.year||x.vehicle.year,make:decoded.make||x.vehicle.make,model:decoded.model||x.vehicle.model,trim:decoded.trim||x.vehicle.trim,drivetrain:decoded.driveType||x.vehicle.drivetrain,bodyClass:decoded.bodyClass||x.vehicle.bodyClass,engine:decoded.engine||x.vehicle.engine,fuelType:decoded.fuelType||x.vehicle.fuelType,manufacturer:decoded.manufacturer||x.vehicle.manufacturer};}catch{/* VIN identity never blocks inventory. */}}));const rows=await Promise.all(found.map(x=>observe(x,db))),seen=new Set(rows.map(x=>x.id));if(db.list){const prior=await db.list('auto/listings/') as VehicleListing[];for(const old of prior)if(old.provider===provider.id&&old.vehicle.make.toLowerCase()===search.make.toLowerCase()&&old.vehicle.model.toLowerCase().includes(search.model.toLowerCase())&&!seen.has(old.id)&&old.active)await markMissing(old,db);}const results=(await analyzeRows(rows,db,now)).sort((a,b)=>b.analysis.score-a.analysis.score);return {mode:provider.demo?'demo':'live',provider:provider.id,disclosure:provider.demo?'DEMO INVENTORY — realistic fictional listings for testing. These vehicles are not for sale.':'Live listings supplied by '+provider.id+'. Prices and availability can change.',results,searchedAt:now};}
export async function vehicleDetail(id:string,db:Store,provider:VehicleInventoryProvider):Promise<VehicleResult>{if(!/^[a-f0-9]{32}$/.test(id))throw new AutoInputError('Vehicle not found.',404);let listing=await db.get('auto/listings/'+id) as VehicleListing|null;if(!listing&&provider.demo){const seeded=await provider.searchVehicles({zip:'78701',make:'Toyota',model:'Land Cruiser',radius:100});for(const row of seeded)await observe(row,db);listing=await db.get('auto/listings/'+id);}if(!listing)throw new AutoInputError('Vehicle not found. Run a search again.',404);const all=((db.list?await db.list('auto/listings/'):[]) as VehicleListing[]).filter(x=>x.provider===listing!.provider);return analyze(listing,await observations(id,db),all,new Date().toISOString());}
export async function decodeVin(vin:string,db:Store,decoder:VinDecoder):Promise<VinIdentity|null>{const normalized=text(vin,17).toUpperCase();if(!/^[A-HJ-NPR-Z0-9]{17}$/.test(normalized))throw new AutoInputError('Enter a valid 17-character VIN.');const key='auto/vins/'+normalized,cached=await db.get(key);if(cached)return cached;const decoded=await decoder.decode(normalized);if(decoded)await db.set(key,decoded);return decoded;}
export function dealPlanFor(vehicle:VehicleResult):DealPlanData{const ask=vehicle.listing.currentPrice,median=vehicle.comparable.medianPrice,opening=money(Math.min(ask*.965,median?median*.94:ask*.95)),high=Math.max(opening,money(Math.min(ask*.985,opening+1000))),walk=Math.max(high,money(Math.min(ask+500,median||ask+500)));const reasons=[...vehicle.analysis.reasons,vehicle.comparable.comparableCount+' close comparable'+(vehicle.comparable.comparableCount===1?'':'s')+' in this dataset'];const process=['Ask for an itemized out-the-door quote.','Keep vehicle price separate from trade-in.','Keep financing separate from the sale-price negotiation.','Ask for every dealer-installed product and fee to be itemized.','Present the opening target with the comparable evidence.','Define your walk-away threshold before visiting.','Review the buyer’s order before signing.'];const vin=vehicle.vehicle.vin||'the listed vehicle',message=`Hi, I’m interested in VIN ${vin}. I’m prepared to purchase this week. Based on comparable inventory and the vehicle’s current market position, I’d be ready to move forward at a selling price of $${opening.toLocaleString('en-US')} before tax, title and registration, with no optional dealer-installed products. Please send an itemized out-the-door quote if that’s workable.`;const checklist=[['Extended warranty','What is excluded, who administers claims, and can I cancel it?','May help when coverage, price and ownership horizon justify it.'],['Service contract','Which services are included and where can they be performed?','Can help when the covered maintenance costs less than paying separately.'],['Paint / fabric protection','What product is applied and what written coverage is included?','Only when the actual protection and price have clear value to you.'],['Wheel / tire coverage','What damage, limits and deductibles apply?','Can help with costly wheels or poor local roads after comparing alternatives.'],['GAP','What loan balance and total-loss gap would remain without it?','Can help on a high loan-to-value purchase; compare insurer and lender pricing.'],['Prepaid maintenance','Which visits are covered and does unused value transfer or refund?','Can help when you will use every included service at a competitive price.'],['VIN etching','Is it optional and what exact benefit does it provide?','Rarely valuable without a meaningful insurance or theft benefit.'],['Dealer accessories','Which items are removable and what is each installed price?','Only when you want the accessory and its installed price is competitive.']].map(([name,questions,whenUseful])=>({name,questions,whenUseful}));return {vehicle,askingPrice:ask,openingTarget:opening,targetLow:opening,targetHigh:high,walkAwayConsideration:walk,estimateDisclosure:'Estimated negotiation strategy based on observed asking prices. It is not a prediction of what a dealer will accept and does not use invoice cost, holdback or assumed dealer motivation.',reasons,process,message,checklist};}
export async function demoDealPlan(id:string,db:Store,provider:VehicleInventoryProvider):Promise<DealReport>{const vehicle=await vehicleDetail(id,db,provider),now=new Date().toISOString();return {id:'demo-'+id,token:null,listingId:id,email:null,stripePaymentId:null,status:'demo',createdAt:now,completedAt:null,reportData:dealPlanFor(vehicle)};}
export async function savePaidDealPlan(id:string,email:string|null,paymentId:string,db:Store,provider:VehicleInventoryProvider){const vehicle=await vehicleDetail(id,db,provider),token=randomUUID().replaceAll('-',''),now=new Date().toISOString(),report:DealReport={id:randomUUID(),token,listingId:id,email,stripePaymentId:paymentId,status:'paid',createdAt:now,completedAt:now,reportData:dealPlanFor(vehicle)};await db.set('auto/deal-reports/'+hash(token),report);return report;}
export async function loadDealPlan(token:string,db:Store){if(!/^[a-f0-9]{32}$/.test(token))throw new AutoInputError('Deal Plan not found.',404);const report=await db.get('auto/deal-reports/'+hash(token));if(!report)throw new AutoInputError('Deal Plan not found.',404);return report as DealReport;}
