import type { Dealer,Vehicle,VehicleInventoryProvider,VehicleListingInput,VehicleSearchInput,VinDecoder,VinIdentity } from './schema.mjs';
const clean=(v:unknown,max=160)=>typeof v==='string'?v.replace(/[<>\x00-\x1f]/g,' ').replace(/\s+/g,' ').trim().slice(0,max):'';
const dollars=(v:any)=>v?.currency==='USD'&&Number.isFinite(+v.value)&&+v.value>0?Math.round(+v.value*100)/100:null;
const yearOf=(s:string)=>Number(s.match(/\b(20\d{2}|19\d{2})\b/)?.[1])||null;
export class NhtsaVinProvider implements VinDecoder {
 constructor(private fetcher:typeof fetch=fetch){}
 async decode(vin:string):Promise<VinIdentity|null>{if(!/^[A-HJ-NPR-Z0-9]{17}$/i.test(vin))return null;try{const r=await this.fetcher('https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValuesExtended/'+encodeURIComponent(vin.toUpperCase())+'?format=json',{redirect:'error',signal:AbortSignal.timeout(8000),headers:{Accept:'application/json'}});if(!r.ok)return null;const x=(await r.json())?.Results?.[0];if(!x)return null;const value=(k:string)=>clean(x[k])||null,liters=Number(x.DisplacementL),displacement=Number.isFinite(liters)&&liters>0?(Math.round(liters*10)/10).toFixed(1)+'L':null;return {vin:vin.toUpperCase(),year:Number(x.ModelYear)||null,make:value('Make'),model:value('Model'),trim:value('Trim')||value('Series'),bodyClass:value('BodyClass'),engine:[displacement,value('EngineConfiguration'),value('EngineCylinders')&&value('EngineCylinders')+' cyl'].filter(Boolean).join(' ')||null,fuelType:value('FuelTypePrimary'),driveType:value('DriveType'),manufacturer:value('Manufacturer'),source:'NHTSA_VPIC',decodedAt:new Date().toISOString()};}catch{return null;}}
}
export class EbayMotorsProvider implements VehicleInventoryProvider {
 id='ebay-motors';demo=false;configured:boolean;private token:string|null=null;private expiry=0;private base:string;
 constructor(private config:{clientId?:string;clientSecret?:string;environment?:string}={},private fetcher:typeof fetch=fetch,private clock=()=>Date.now()){this.configured=Boolean(config.clientId&&config.clientSecret);this.base=config.environment==='sandbox'?'https://api.sandbox.ebay.com':'https://api.ebay.com';}
 private async accessToken(){if(this.token&&this.expiry>this.clock()+60000)return this.token;const r=await this.fetcher(this.base+'/identity/v1/oauth2/token',{method:'POST',signal:AbortSignal.timeout(8000),headers:{Authorization:'Basic '+Buffer.from(this.config.clientId+':'+this.config.clientSecret).toString('base64'),'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({grant_type:'client_credentials',scope:'https://api.ebay.com/oauth/api_scope'}).toString()});if(!r.ok)throw Error('EBAY_AUTH');const data=await r.json();this.token=data.access_token;this.expiry=this.clock()+(Number(data.expires_in)||7200)*1000;return this.token!;}
 private async api(path:string,zip?:string){const r=await this.fetcher(this.base+'/buy/browse/v1/'+path,{signal:AbortSignal.timeout(12000),headers:{Authorization:'Bearer '+await this.accessToken(),'X-EBAY-C-MARKETPLACE-ID':'EBAY_US',...(zip?{'X-EBAY-C-ENDUSERCTX':'contextualLocation=country=US,zip='+zip}:{})}});if(!r.ok)throw Error('EBAY_'+r.status);return r.json();}
 private normalize(x:any,now:string):VehicleListingInput|null{const title=clean(x?.title),price=dollars(x?.price),year=yearOf(title);if(!title||!price||!year||!/^https:\/\/www\.ebay\.com\//.test(String(x?.itemWebUrl||'')))return null;const make=clean(x?.localizedAspects?.find((a:any)=>/make/i.test(a.name))?.value)||title.split(/\s+/)[1]||'',model=clean(x?.localizedAspects?.find((a:any)=>/^model$/i.test(a.name))?.value)||title.split(/\s+/)[2]||'';if(!make||!model)return null;const vin=clean(x?.localizedAspects?.find((a:any)=>/^vin$/i.test(a.name))?.value).toUpperCase(),mileage=Number(String(x?.localizedAspects?.find((a:any)=>/mileage/i.test(a.name))?.value||'').replace(/[^0-9]/g,''))||null,loc=x?.itemLocation||x?.seller?.sellerLegalInfo?.businessInfo?.businessAddress||{};const dealerName=clean(x?.seller?.username)||'eBay Motors seller',dealer:Dealer={id:'ebay-dealer-'+clean(x?.seller?.username,80).replace(/[^a-z0-9]/gi,'-').toLowerCase(),name:dealerName,address:null,city:clean(loc.city)||'Location not supplied',state:clean(loc.stateOrProvince)||'',zip:clean(loc.postalCode,10)||'',lat:null,lng:null,source:'EBAY'};const vehicle:Vehicle={id:'ebay-vehicle-'+(vin||x.itemId),vin:/^[A-HJ-NPR-Z0-9]{17}$/.test(vin)?vin:null,year,make,model,trim:clean(x?.localizedAspects?.find((a:any)=>/trim/i.test(a.name))?.value)||null,drivetrain:null,bodyClass:null,engine:null,fuelType:null,manufacturer:make};return {provider:this.id,providerListingId:clean(x.itemId,120),vehicle,dealer,url:x.itemWebUrl,imageUrl:String(x?.image?.imageUrl||'').startsWith('https://')?x.image.imageUrl:null,mileage,currentPrice:price,observedAt:now,active:true,demo:false};}
 async searchVehicles(input:VehicleSearchInput){if(!this.configured)return [];const qs=new URLSearchParams({q:[input.yearMin&&input.yearMax&&input.yearMin===input.yearMax?input.yearMin:'',input.make,input.model].filter(Boolean).join(' '),category_ids:'6001',limit:'50',filter:'buyingOptions:{FIXED_PRICE},priceCurrency:USD'});const data=await this.api('item_summary/search?'+qs,input.zip),now=new Date(this.clock()).toISOString();return (data.itemSummaries||[]).map((x:any)=>this.normalize(x,now)).filter(Boolean) as VehicleListingInput[];}
